<%= turbo_frame_tag "post_comment_form" do %>
  <%= form_with(model: [ @post, Comment.new ], local: true) do |form| %>
    <div class="mb-4">
      <%= form.text_area :body, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-black", placeholder: "Write a comment" %>
    </div>

    <div>
      <%= form.submit "Post Comment", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>
<% end %>