<div class="prose mx-auto">
  <h2 class="text-4xl font-bold text-gray-200 mb-6">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6 mb-6" }) do |f| %>
    <div class="flex flex-col">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Email" %>
    </div>

    <div class="flex flex-col">
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field flex items-center">
        <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 bg-gray-800 border-gray-700 rounded focus:ring-blue-500" %>
        <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-300" %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Log in", class: "w-full py-2 px-4 bg-blue-600 text-white font-semibold rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>