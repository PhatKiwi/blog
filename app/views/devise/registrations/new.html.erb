<div class="prose mx-auto">
  <h2 class="text-4xl font-bold text-gray-200 mb-6">Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6 mb-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="flex flex-col">
      <%= f.label :email, class: "text-sm font-medium text-gray-200" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="flex flex-col">
      <%= f.label :username, class: "text-sm font-medium text-gray-200" %>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="flex flex-col">
      <%= f.label :password, class: "text-sm font-medium text-gray-200" %>
      <% if @minimum_password_length %>
        <em class="text-xs text-gray-500">(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="flex flex-col">
      <%= f.label :password_confirmation, class: "text-sm font-medium text-gray-200" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.submit "Sign up", class: "w-full py-2 px-4 bg-indigo-600 text-white font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    </div>
  <% end %>
  <div>
    <%= render "devise/shared/links" %>
  </div>
</div>
