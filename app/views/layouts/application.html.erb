<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-900 text-white prose mx-auto">
    <p class="notice text-green-500"><%= notice %></p>
    <p class="alert text-red-500"><%= alert %></p>

    <div class="container mx-auto p-4">
      <% if user_signed_in? %>
        <p>Logged in as <strong class="text-white"><%= current_user.email %></strong>.</p>
        <% if current_user.admin? %>
          <%= link_to "New Blog Post", new_post_path, class: "text-blue-500 hover:underline" %> |
        <% end %>
        <%= link_to "Edit profile", edit_user_registration_path, class: "text-blue-500 hover:underline" %> |
        <%= link_to "Logout", destroy_user_session_path, "data-turbo-method": :delete, class: "text-blue-500 hover:underline" %>
      <% else %>
        <%= link_to "Sign up", new_user_registration_path, class: "text-blue-500 hover:underline" %> |
        <%= link_to "Login", new_user_session_path, class: "text-blue-500 hover:underline" %>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
