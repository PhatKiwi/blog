<%= form_with model: post, local: true, class: "space-y-6" do |form| %>
  <% if form.object.errors.any? %>
    <div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
      <h2 class="font-bold text-lg"><%= pluralize(form.object.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul class="mt-2 list-disc list-inside">
        <% form.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="flex flex-col">
    <%= form.text_field :title, class: "border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none text-black", placeholder: "Title" %>
  </div>

  <div class="flex flex-col">
    <%= form.text_area :body, rows: 8, class: "border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none text-black", placeholder: "Write something in markdown..." %>
  </div>

  <div>
    <%= form.button "Submit", class: "bg-blue-500 text-white font-medium py-2 px-4 rounded hover:bg-blue-600 focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
  </div>
<% end %>
