<h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Blog Posts</h1>

<% @posts.each do |post| %>
  <%= link_to post_path(post), class: "no-underline" do %>
    <div class="post bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-6 hover:shadow-lg">
      <h2 class="text-2xl font-bold text-blue-600 dark:text-blue-400">
        <%= post.title %>
      </h2>
      <p class="text-gray-700 dark:text-gray-300 mt-4">
        <%= truncate(post.body, length: 200) %>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
        Published on <%= post.created_at.strftime("%B %d, %Y") %> by <%= post.user.email %>
      </p>
    </div>
  <% end %>
<% end %>