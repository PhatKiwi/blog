<div>
  <%= render "shared/nav"%>
  <div class="max-w-4xl mx-auto p-6 bg-gray-800 shadow-md rounded-lg mt-16">
    <h1 class="text-3xl font-bold text-white mb-4"><%= @post.title %></h1>

    <p class="text-gray-300 text-lg mb-6"><%= markdown(@post.body) %></p>

    <div class="text-sm text-gray-400 mb-4">
      <p><strong class="text-gray-400">Author:</strong> <%= @post.user.email %></p>
      <p><strong class="text-gray-400">Published on:</strong> <%= @post.created_at.strftime("%B %d, %Y") %></p>
    </div>

    <div class="flex space-x-4">
      <%= link_to 'Back to Posts', root_path, class: 'btn bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-600' %>
      <% if current_user.try(:admin) %>
        <%= link_to "Edit Post", edit_post_path, class: 'btn bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-500' %>
        <%= link_to "Delete Post", post_path, 'data-turbo-method': :delete, 'data-turbo-confirm': "Are you sure?", class: 'btn bg-red-600 text-white px-4 py-2 rounded hover:bg-red-500' %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-2xl font-bold text-white mb-4">Comments</h2>

    <div class="bg-gray-900 p-6 rounded-lg">
      <%= render @post.comments %>
      <% if current_user %>
        <%= render partial: 'comments/form'%>
      <% end%>
    </div>
  </div>
</div>
