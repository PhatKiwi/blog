<div>
  <%= render "shared/nav"%>
  <div class="mx-auto max-w-none p-6 bg-gray-800 shadow-md rounded-lg mt-16">
    <h1 class="text-4xl font-bold text-white mb-4"><%= @post.title %></h1>

    <div class="bg-gray-300 text-gray-800 p-4 rounded-lg mb-6">
      <%= markdown(@post.body) %>
    </div>

    <div class="text-sm text-gray-400 mb-4">
      <p><strong class="text-gray-400">Author:</strong> <%= @post.user.username %></p>
      <p><strong class="text-gray-400">Published on:</strong> <%= @post.created_at.strftime("%B %d, %Y") %></p>
    </div>
    <div>
      <% @post.tag_list.each do |tag| %>
        <span class="inline-block bg-gray-600 text-white text-sm font-medium rounded-full px-3 py-1 mr-2">
          #<%= tag %>
        </span>
      <% end %> 
    </div>

    <div class="flex space-x-4 mt-4">
      <%= link_to 'Back to Posts', root_path, class: 'btn bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-600' %>
      <% if current_user.try(:admin) %>
        <%= link_to "Edit Post", edit_post_path, class: 'btn bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-500' %>
        <%= link_to "Delete Post", post_path, 'data-turbo-method': :delete, 'data-turbo-confirm': "Are you sure?", class: 'btn bg-red-600 text-white px-4 py-2 rounded hover:bg-red-500' %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-3">
        <%= turbo_frame_tag "post_#{@post.id}_comment_count" do %>
          <%= pluralize(@post.comments.size, 'Comment') %>
        <% end %>
      </h2>
      
    <div class="bg-gray-900 p-6 rounded-lg">
      <%= turbo_stream_from "comments" %>
      <div id="comments">
        <%= render partial: "comments/comment", collection: @post.comments %>
      </div>
    </div>
      <% if current_user %>
      <div class="p6">
        <%= turbo_frame_tag "post_comment_form" do %>
          <%= render partial: 'comments/form'%>
        <% end %>
      </div>
      <% end%>
  </div>
</div>
