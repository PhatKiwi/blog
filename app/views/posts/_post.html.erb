
<div class="bg-gray-800 shadow-md rounded-lg p-6 mb-6 hover:shadow-lg hover:bg-gray-700 transition">
  <%= link_to post_path(post), class: "no-underline block" do %>
    <div>
      <% if post.draft? %>
        <span class="bg-red-500 text-white text-xs font-semibold rounded-full px-2 py-1">
          DRAFT
        </span>
      <% end %>
    </div>
    <div class="text-2xl font-bold text-blue-400">
      <%= post.title %>
    </div>
    <div class="text-sm text-gray-400 mt-2">
      Published on <%= post.published_at&.strftime("%B %d, %Y") %> by <%= post.user.username %>
    </div>
    <div>
      <% post.tag_list.each do |tag| %>
        <span class="inline-block bg-gray-600 text-white text-sm font-medium rounded-full px-3 py-1 mr-2">
          #<%= tag %>
        </span>
      <% end %> 
    </div>
  <% end %>
  <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-700">
    <div class="text-sm text-gray-300">
      Comments: <%= post.comments.count %>
    </div>
    <%= render 'likes/button', post: post %>
  </div>
</div>